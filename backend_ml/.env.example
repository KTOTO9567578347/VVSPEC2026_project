# Скопируй в .env и поправь под себя (все переменные необязательны)
BACKEND_DATABASE_URL=sqlite:///./telemetry.db
# BACKEND_DATABASE_URL=postgresql+psycopg://robot:robot@localhost:5432/telemetry
BACKEND_HTTP_PORT=8000
BACKEND_GRPC_PORT=50051
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
BACKEND_ROBOT_ONLINE_TIMEOUT_S=15
BACKEND_DEFAULT_WINDOW_S=600
BACKEND_LOG_LEVEL=INFO
