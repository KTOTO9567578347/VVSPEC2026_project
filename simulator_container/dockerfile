# https://docker.com
FROM ros@sha256:c5705f613a6427d07be6f3d0aba40068e16c3dea05604e1c95c63eac79fea658

ENV ROS_VERSION=2
ENV ROS_DISTRO=jazzy
ENV ROS_ROOT=/opt/ros/$ROS_DISTRO
ENV RCUTILS_LOGGING_BUFFERED_STREAM=1
ENV RCUTILS_COLORIZED_OUTPUT=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CMAKE_BUILD_TYPE=Release
ENV DEBIAN_FRONTEND=noninteractive

# --no-install-recommends
RUN echo '\
APT::Install-Recommends "0";\n\
APT::Install-Suggests "0";\n\
' > /etc/apt/apt.conf.d/01norecommend

# Install cyclonedds RMW
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
RUN apt update && \
    apt install -y ros-$ROS_DISTRO-rmw-cyclonedds-cpp && \
    rm -rf /var/lib/apt/lists/*

# Install foxglove bridge v0.8.5
# Install foxglove bridge v0.8.5 (Установка официального бинарного пакета)
RUN apt update && \
    apt install -y ros-$ROS_DISTRO-foxglove-bridge && \
    rm -rf /var/lib/apt/lists/*

# Install Nav2 dependencies
RUN apt update && \
    apt install -y \
    ros-$ROS_DISTRO-nav2-core \
    ros-$ROS_DISTRO-nav2-controller \
    ros-$ROS_DISTRO-nav2-bt-navigator \
    ros-$ROS_DISTRO-nav2-lifecycle-manager \
    ros-$ROS_DISTRO-nav2-behaviors \
    ros-$ROS_DISTRO-nav2-planner \
    ros-$ROS_DISTRO-nav2-navfn-planner \
    ros-$ROS_DISTRO-nav2-regulated-pure-pursuit-controller \
    ros-$ROS_DISTRO-nav2-amcl \
    ros-$ROS_DISTRO-nav2-map-server \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && \
    apt install -y \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

# Install slam toolbox with patch
WORKDIR /tmp/slam-toolbox-build
ADD docker/slam-toolbox.patch .
RUN . $ROS_ROOT/setup.sh \
    && mkdir src \
    && echo "\
    - git:\n\
        local-name: slam_toolbox\n\
        uri: https://github.com/SteveMacenski/slam_toolbox-release.git\n\
        version: release/jazzy/slam_toolbox/2.8.3-1\n\
    " | vcs import src \
    && sed -i 's/\r$//' slam-toolbox.patch \
    && (cd src/slam_toolbox && git apply ../../slam-toolbox.patch) \
    && rosdep update \
    && apt update \
    && rosdep install --from-paths src --ignore-src -y \
    && colcon build --merge-install --install-base /opt/ros/$ROS_DISTRO \
    --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /tmp/* \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================================
# Сборка gRPC и Protobuf из исходников
# ==============================================================================
# 1. Устанавливаем системные зависимости сборщика, чтобы ускорить компиляцию в 3 раза
RUN apt update && apt install -y \
    nlohmann-json3-dev \
    build-essential \
    cmake \
    git \
    libopencv-dev \
    liblua5.1-0-dev \
    libboost-dev \
    libboost-date-time-dev \
    libboost-filesystem-dev \
    libboost-system-dev \
    python3-colcon-common-extensions \
    libssl-dev \
    zlib1g-dev \
    libc-ares-dev \
    libre2-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Скачиваем, собираем и очищаем всё строго в ОДНОМ RUN слое
RUN git clone --recurse-submodules -b v1.66.0 --depth 1 --shallow-submodules https://github.com/grpc/grpc /tmp/grpc-build \
    && cd /tmp/grpc-build \
    && mkdir -p cmake/build \
    && cd cmake/build \
    # Используем внешние системные библиотеки пакетов (-DgRPC_<pkg>_PROVIDER=package)
    && cmake -DgRPC_INSTALL=ON \
             -DgRPC_BUILD_TESTS=OFF \
             -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_CXX_STANDARD=17 \
             -DCMAKE_INSTALL_PREFIX=/usr/local \
             -DgRPC_SSL_PROVIDER=package \
             -DgRPC_ZLIB_PROVIDER=package \
             -DgRPC_CARES_PROVIDER=package \
             -DgRPC_RE2_PROVIDER=package \
             ../.. \
    && make -j$(nproc) \
    && make install \
    # Чистим кэш и кэшируем динамические библиотеки (.so)
    && cd / \
    && rm -rf /tmp/grpc-build \
    && ldconfig
# ==============================================================================

# Build the Jazzy-compatible ROS 2 Flatland integration from OpenRobOps.
# Its pinned submodule points to the official avidbots/flatland ROS 2 branch.
COPY docker/flatland-laser-inf.patch /tmp/flatland-laser-inf.patch
RUN git clone https://github.com/OpenRobOps/sim-flatland.git /tmp/sim-flatland \
    && git -C /tmp/sim-flatland fetch --depth 1 origin 0c4d0f441947dc1624efd132539d7b16158e1e31 \
    && git -C /tmp/sim-flatland checkout --detach FETCH_HEAD \
    && git -C /tmp/sim-flatland submodule update --init \
    && cd /tmp/sim-flatland/third_party/flatland \
    && for patch in /tmp/sim-flatland/patches/flatland/000[1-9]-*.patch /tmp/sim-flatland/patches/flatland/0010-*.patch /tmp/sim-flatland/patches/flatland/0013-*.patch /tmp/sim-flatland/patches/flatland/0016-*.patch; do \
        git apply --whitespace=nowarn "$patch"; \
    done \
    && sed -i 's/\r$//' /tmp/flatland-laser-inf.patch \
    && git apply --whitespace=nowarn /tmp/flatland-laser-inf.patch \
    && rm -rf .git /tmp/flatland-laser-inf.patch \
    && cd /tmp \
    && git clone --branch v2.3.1 --depth 1 https://github.com/erincatto/box2d.git \
    && cd /tmp/box2d/Box2D/Build \
    && cmake -DBOX2D_BUILD_EXAMPLES=OFF -DBOX2D_BUILD_TESTS=OFF \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_INSTALL_PREFIX=/usr/local .. \
    && make -j$(nproc) \
    && make install \
    && cd /tmp/sim-flatland/third_party/flatland \
    && . $ROS_ROOT/setup.sh \
    && apt update \
    && rosdep update \
    && rosdep install --from-paths flatland_msgs flatland_server flatland_plugins --ignore-src -r -y --skip-keys box2d-dev \
    && colcon build --merge-install --install-base /opt/ros/$ROS_DISTRO \
        --packages-select flatland_msgs flatland_server flatland_plugins \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /tmp/sim-flatland /tmp/box2d \
    && rm -rf /var/lib/apt/lists/*

# Setup .bashrc
WORKDIR /src
RUN echo '\
export LD_LIBRARY_PATH=$ROS_ROOT/lib/$(gcc -dumpmachine):${LD_LIBRARY_PATH}\n\
source $ROS_ROOT/setup.bash\n\
LOCAL_SETUP="/src/install/setup.bash";\n\
if [ -f "$LOCAL_SETUP" ]; then source $LOCAL_SETUP; fi\n\
' >> /root/.bashrc

# Entrypoint
WORKDIR /src
ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["trap : TERM INT; sleep infinity & wait"]

